# hydro-sphere-id — initial-data smoke test for the TestMCNuX hydro-profile
# writers of specs/verification-suite-design.md [MCNX-VER-02/04].
#
# The "uniform sphere" value of HydroBaseX::initial_hydro is an
# EXTENDS-KEYWORD addition from TestMCNuX; the writer evaluates the piecewise
# profile
#
#   (rho, T, Ye)(x) = (rho0, T0, Ye0)          if |x - x0| <= R_s
#                     (rho_amb, T_amb, Ye_amb) otherwise
#
# at every cell center (no volume-fraction smoothing), with vel = 0 and every
# other written HydroBaseX field zero. Units pass through verbatim: rho in
# g/cm^3, temperature in MeV ([MCNX-HYD-04]), Ye dimensionless. The
# "equilibration box" profile is the everywhere-inside branch of the same
# writer. The golden TSVs are diffed at the harness defaults
# ABSTOL = RELTOL = 1e-12.
#
# Grid pinning (verification-suite-design.md "Open questions / assumptions",
# cell-centered sharp sphere surface): on this 16^3 grid over [-1, 1]^3
# (dx = 0.125, cell centers at +-0.0625 + n*0.125) with the sphere centered
# at the origin, R_s = 0.609 sits between the cell-center distance shells
# 0.596212... and 0.621867..., so the nearest cell-center distance to the
# surface is 0.012788 = 0.1023*dx (no FP-marginal surface classification),
# and the realized sphere volume N_inside*dx^3 = 480*(0.125)^3 = 0.9375
# matches (4/3)*pi*R_s^3 = 0.946108 to 0.910% <= 1% (counted over all
# 16^3 cell centers when this golden was captured).
#
# ODESolvers must be active: with it, both ADMBaseX_InitialData and
# HydroBaseX_InitialData are scheduled IN ODESolvers_Initial, and MCNuX
# INHERITS: ADMBaseX (flat Minkowski metric via the ADMBaseX defaults).

ActiveThorns = "
    CarpetX
    IOUtil
    ODESolvers
    ADMBaseX
    HydroBaseX
    MCNuX
    TestMCNuX
"

# Mandatory for any MCNuX run: CarpetX's own CCTK_PARAMCHECK routine rejects
# every other presync mode.
Cactus::presync_mode = "mixed-error"

# All MCNuX verification scaffolding off: this benchmark exercises only the
# TestMCNuX hydro-profile writer. The analytic coefficient source keeps the
# run table-free.
MCNuX::test_synthetic_packets = no
MCNuX::test_synthetic_deposit = no
MCNuX::run_selftests = no
MCNuX::opacity_source = "analytic"

# Flat background: the ADMBaseX defaults, restated.
ADMBaseX::initial_data = "Cartesian Minkowski"
ADMBaseX::initial_lapse = "one"
ADMBaseX::initial_shift = "zero"

# The subject of this benchmark: the TestMCNuX "uniform sphere" profile.
# T0/T_amb are MeV-valued by contract ([MCNX-HYD-04]); there is no code-level
# unit guard.
HydroBaseX::initial_hydro = "uniform sphere"
TestMCNuX::rho0 = 1.0e12
TestMCNuX::T0 = 5.0
TestMCNuX::Ye0 = 0.25
TestMCNuX::rho_amb = 1.0e6
TestMCNuX::T_amb = 1.0
TestMCNuX::Ye_amb = 0.45
TestMCNuX::sphere_x0 = 0.0
TestMCNuX::sphere_y0 = 0.0
TestMCNuX::sphere_z0 = 0.0
TestMCNuX::sphere_radius = 0.609

# 16^3 cells over the CarpetX default domain [-1, 1]^3 (dx = 0.125): the
# grid pinned by the surface-margin/volume analysis above.
CarpetX::ncells_x = 16
CarpetX::ncells_y = 16
CarpetX::ncells_z = 16

# Initial-data smoke only: no evolution.
Cactus::cctk_itlast = 0

IO::out_dir = $parfile
IO::out_every = 1
IO::parfile_write = no

# Keep the column-label header but drop IOUtil's creation date, hostname, and
# absolute parameter-file path (see unit-selftest.par).
IO::out_fileinfo = "axis labels"

CarpetX::out_metadata = no

# 1D output lines through the cell-center row (y, z) = (0.0625, 0.0625) etc.:
# the fields are cell-centered, so the lines pass through cell centers
# exactly, and each line crosses the sphere surface (along the x line the
# cell-center distance sqrt(x^2 + 2*0.0625^2) is <= R_s for |x| <= 0.5625 and
# > R_s for |x| >= 0.6875), capturing both profile branches.
IO::out_xline_y = 0.0625
IO::out_xline_z = 0.0625
IO::out_yline_x = 0.0625
IO::out_yline_z = 0.0625
IO::out_zline_x = 0.0625
IO::out_zline_y = 0.0625

# The golden data: the piecewise (rho, T, Ye) fields, the rest-frame velocity,
# and two zeroed-field witnesses.
CarpetX::out_tsv_vars = "
    HydroBaseX::rho
    HydroBaseX::temperature
    HydroBaseX::Ye
    HydroBaseX::vel
    HydroBaseX::eps
    HydroBaseX::press
"
