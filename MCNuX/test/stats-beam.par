# stats-beam — the beam-attenuation statistical benchmark of
# specs/neutrino-matter-interactions.md:197-200 ([MCNX-INT-01]/[MCNX-INT-03]
# Verification: beam attenuation, statistical, 4 sigma) and
# specs/verification-suite-design.md:265 ([MCNX-VER-07]): a collimated
# monoenergetic nu_e packet beam crossing a uniform pure-absorber
# (eta_scale = 0, kappa_s = 0) slab on flat Minkowski, resolved by the
# episode driver in ONE transport step to absorbed-or-escaped, and reduced
# by MCNuX_StatsBeam into per-check (estimate, expected, sigma, z) rows,
# golden in MCNuX::mcnux_stats_beam_diag. Acceptance |z| <= 4 at the pinned
# packet count and seed was verified once at golden capture ([MCNX-RNG-07]:
# no seed shopping); thereafter the archived z values are themselves golden
# numbers diffed at the harness defaults ABSTOL = RELTOL = 1e-12 (the check
# is deterministic at pinned seed).
#
# Check rows (SIZE=2; layout owned by mcnux_interactions.cxx):
#   0  transmitted packet count (the [MCNX-GPU-05] escape tally of the beam
#      species: with kappa_s = 0 every non-absorbed packet provably reaches
#      the far face — Delta t_s = +inf) vs N_p exp(-kappa_a L), sigma =
#      sqrt(N_p p (1 - p)) (binomial; mcnux_stats_beam.hxx, benchmark-owned
#      per the mcnux_stats.hxx non-goal);
#   1  exact count closure: transmitted + absorbed vs N_p at sigma = 1, so
#      z is the raw packet discrepancy (0 at closure) — the [MCNX-INT-03]
#      discreteness observable (every absorption removes exactly one whole
#      packet; every packet is resolved within the step).
#
# Pinned values ([MCNX-VER-07]: a benchmark pins its values in its parfile):
#   N_p       = 1048576 = 2^20 (the beam_num_packets default, restated —
#               the pinned statistical packet count of [MCNX-RNG-07]);
#   seed      = 1296518744 (the pinned primary seed, restated);
#   E         = 10 MeV (monoenergetic; the attenuation law is
#               energy-independent for gray kappa_a: p^t/nu = 1 at rest);
#   beam_x0   = -0.875 (the cell-0 center plane; strictly inside, off the
#               x_lo face — the escape predicate is half-open);
#   L         = x_hi - beam_x0 = 1.0 - (-0.875) = 1.875 (code units);
#   kappa_a0  = 3.6e-6 cm^-1 -> kappa_code = 3.6e-6 * 1.4766e5 ~ 0.53159
#               (the pinned cgs->code factor, the absorb-smoke worked
#               example), so kappa_code * L ~ 0.99672 and
#               p = exp(-kappa L) ~ 0.36909: expected transmitted
#               ~ 387,020 of 2^20, sigma ~ 494.
#
# ONE transport step with an explicit timestep dt = 1.8750001 slightly
# above L (c = 1): every surviving packet crosses the whole slab and
# escapes within the step, and the tiny remainder delta = 1e-7 keeps the
# post-escape overshoot far inside the boundary ghost layer while the
# expected number of spurious post-escape absorptions,
# ~ N_p p kappa delta ~ 2e-2 packets, is negligible against sigma ~ 494
# (the closure row 1 stays exact either way). ~9 sampling episodes per
# surviving packet (8 cell crossings + the step end), far under the
# driver's 10000 episode cap.
#
# Every per-packet mirror stays OFF (their SIZE=8 tables hard-error at the
# 2^20 packet scale — the beam output is an aggregate reduction, the
# stats-emission precedent); the ledger closure is off (absorption-deposit
# closure is covered by absorb-smoke at small count). eta_scale[0] = 0 is
# the spec's eta_scale = 0 slab (no emission loop runs anyway:
# enable_emission is forbidden with the beam by PARAMCHECK).
#
# ODESolvers must be active: ADMBaseX and HydroBaseX initial data are both
# scheduled IN ODESolvers_Initial, and the driver reads metric and fluid.

ActiveThorns = "
    CarpetX
    IOUtil
    ODESolvers
    ADMBaseX
    HydroBaseX
    MCNuX
    TestMCNuX
"

# Mandatory for any MCNuX run: CarpetX's own CCTK_PARAMCHECK routine rejects
# every other presync mode.
Cactus::presync_mode = "mixed-error"

# The subject of this benchmark: the deterministic beam fixture resolved by
# the episode driver, reduced by the beam statistical writer. All other
# verification scaffolding is off.
MCNuX::enable_interactions = yes
MCNuX::test_stats_beam = yes
MCNuX::enable_emission = no
MCNuX::test_stats_emission = no
MCNuX::test_synthetic_packets = no
MCNuX::test_id_contract = no
MCNuX::test_escape_tallies = no
MCNuX::test_emission = no
MCNuX::test_fluid_gather = no
MCNuX::test_synthetic_deposit = no
MCNuX::test_ledger_closure = no
MCNuX::run_selftests = no

# The pinned primary statistical seed ([MCNX-RNG-07]; the rng_seed default,
# restated) and the beam fixture pins (all defaults, restated per the
# pinned-values rule above).
MCNuX::rng_seed = 1296518744
MCNuX::beam_num_packets = 1048576
MCNuX::beam_energy_MeV = 10.0
MCNuX::beam_x0 = -0.875

# Analytic coefficient source: pure absorption for nu_e (the beam's only
# species). kappa_s0[0] keeps its 0 default (Delta t_s = +inf, no scattering
# ever fires); eta_scale[0] = 0 is the spec's eta_scale = 0 slab.
MCNuX::opacity_source = "analytic"
MCNuX::kappa_a0[0] = 3.6e-6
MCNuX::eta_scale[0] = 0.0

# Flat background: the ADMBaseX defaults, restated.
ADMBaseX::initial_data = "Cartesian Minkowski"
ADMBaseX::initial_lapse = "one"
ADMBaseX::initial_shift = "zero"

# Uniform at-rest fluid everywhere (T0 > 0 keeps the analytic Kirchhoff
# form well-defined even though eta is unused at eta_scale = 0).
HydroBaseX::initial_hydro = "equilibration box"
TestMCNuX::rho0 = 1.0e12
TestMCNuX::T0 = 5.0
TestMCNuX::Ye0 = 0.25

# 8^3 cells over the CarpetX default domain [-1, 1]^3 (dx = 0.25): the slab
# is the full x extent from the seed plane to the far face.
CarpetX::ncells_x = 8
CarpetX::ncells_y = 8
CarpetX::ncells_z = 8

# ONE step at the explicit slab-crossing timestep (see header; never via
# dtfac — the schwarzschild-pt precedent): it000000 is the defined all-zero
# snapshot, it000001 the single beam-resolution step reduced into the check
# rows.
CarpetX::timestep_choice = "timestep"
CarpetX::timestep = 1.8750001
Cactus::cctk_itlast = 1

IO::out_dir = $parfile
IO::out_every = 1
IO::parfile_write = no

# Keep the column-label header but drop IOUtil's creation date, hostname, and
# absolute parameter-file path (see unit-selftest.par).
IO::out_fileinfo = "axis labels"

CarpetX::out_metadata = no

# The golden data: the beam statistical-check verdict table only.
CarpetX::out_tsv_vars = "
    MCNuX::mcnux_stats_beam_diag
"
