# minkowski-freestream — flat-spacetime exactness of the geodesic push of
# specs/geodesic-propagation.md as a Cactus regression test.
#
# [MCNX-GEO-04]/[MCNX-GEO-01]: on Minkowski (ADMBaseX "Cartesian Minkowski",
# lapse one, shift zero) the right-hand side of p_i vanishes identically and
# every packet travels a straight line at coordinate speed 1. The
# deterministic synthetic fixture of MCNuX_SeedSyntheticPackets (eight
# packets: six axis-aligned directions at four momentum magnitudes plus two
# oblique ones) is pushed for four transport steps; the per-packet table
# MCNuX::mcnux_packet_diag (position, lower momentum, covariant energy
# p_t = -alpha^2 p^t + beta^i p_i = -|p| here) is golden-checked at the
# harness defaults ABSTOL = RELTOL = 1e-12 ([MCNX-VER-01]) at every
# iteration. The momentum columns are bitwise constant, the position columns
# advance by dt p_i/|p| per step, and p_t is conserved ([MCNX-GEO-05]).
# [MCNX-GEO-03] is exercised on the constant fields (gathered values exact,
# derivatives identically zero); the linear-field legs are unit-selftest rows.
#
# ODESolvers must be active: ADMBaseX schedules its initial-data groups only
# IN ODESolvers_Initial when ODESolvers is active, and MCNuX_GeodesicPush
# reads the metric, lapse, and shift. With no evolved variables
# ODESolvers_Solve only warns, and the MCNuX transport group's
# AFTER ODESolvers_Solve ordering resolves for real.
#
# No interactions, no RNG draw: the run is fully deterministic.

ActiveThorns = "
    CarpetX
    IOUtil
    ODESolvers
    ADMBaseX
    MCNuX
"

# Mandatory for any MCNuX run: CarpetX's own CCTK_PARAMCHECK routine rejects
# every other presync mode.
Cactus::presync_mode = "mixed-error"

# The subject of this benchmark: the synthetic packet fixture and its push.
# The other verification scaffolding is off.
MCNuX::test_synthetic_packets = yes
MCNuX::test_synthetic_deposit = no
MCNuX::run_selftests = no

# Zero opacities (verification-suite-design.md: "no interactions"): the
# analytic coefficient source with its default kappa_a0 = kappa_s0 = 0.
# Nothing consumes the coefficients yet; this documents the intent.
MCNuX::opacity_source = "analytic"

# Flat background: the ADMBaseX defaults, restated.
ADMBaseX::initial_data = "Cartesian Minkowski"
ADMBaseX::initial_lapse = "one"
ADMBaseX::initial_shift = "zero"

# 8^3 cells over the CarpetX default domain [-1, 1]^3 (dx = 0.25; default
# dtfac gives dt = 0.125). Four steps move every packet by 0.5 from a seed
# position inside |x^i| <= 0.25, so all stay inside the domain and the
# escape policy is never exercised.
CarpetX::ncells_x = 8
CarpetX::ncells_y = 8
CarpetX::ncells_z = 8

Cactus::cctk_itlast = 4

IO::out_dir = $parfile
IO::out_every = 1
IO::parfile_write = no

# Keep the column-label header but drop IOUtil's creation date, hostname, and
# absolute parameter-file path (see unit-selftest.par).
IO::out_fileinfo = "axis labels"

CarpetX::out_metadata = no

# The golden data: the per-packet diagnostic table, one file per iteration.
CarpetX::out_tsv_vars = "
    MCNuX::mcnux_packet_diag
"
