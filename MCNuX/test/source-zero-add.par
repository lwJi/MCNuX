# source-zero-add — the zero-then-add protocol and ledger deposition of
# specs/hydro-coupling-source-terms.md as a Cactus regression test.
#
# [MCNX-HYD-03]: the source-term variables are zeroed at one schedule point
# (the start of MCNuX_TransportStep), accumulated into by contributors
# (MCNuX_SyntheticDeposit in MCNuX_AddToSourceTerms), and only then read (the
# TSV writer at end of iteration). [MCNX-HYD-02]: the deposited totals equal
# the injected synthetic event sums — the three sign fixtures (nu_e emission,
# nu_e absorption, elastic scattering), one per fixture cell, each on one TSV
# output line — pushed through the shared ledger arithmetic with fixed
# synthetic (dP, dL, dV, dt).
#
# Two transport steps make the zero-then-add ordering observable: the
# synthetic list is iteration-scaled (value at iteration n is n times the
# iteration-1 value), so a missing or misordered zero point would carry
# iteration 1's deposit into iteration 2 (3x instead of 2x the base value) and
# fail the golden diff at the harness defaults ABSTOL = RELTOL = 1e-12
# ([MCNX-VER-01]). Iteration 0 pins the all-zero initial data. The driver's
# presync/poison machinery enforces the completeness of the routines'
# READS:/WRITES: declarations during the same run ([MCNX-CTX-04]).
#
# The background is flat and no packets exist; the run is fully deterministic
# (no RNG draw happens anywhere).

# ADMBaseX is required by every MCNuX run since MCNuX INHERITS: ADMBaseX
# (read access to the spacetime interface for the geodesic push); nothing
# here reads the metric, so no ODESolvers/initial data is needed.
ActiveThorns = "
    CarpetX
    IOUtil
    ADMBaseX
    HydroBaseX
    MCNuX
"

# Mandatory for any MCNuX run: CarpetX's own CCTK_PARAMCHECK routine rejects
# every other presync mode.
Cactus::presync_mode = "mixed-error"

# The subject of this benchmark: the parameter-gated synthetic-event
# contributor. The self-test battery is off — its rows are unit-selftest's
# golden data, not this benchmark's.
MCNuX::test_synthetic_deposit = yes
MCNuX::run_selftests = no

# 8^3 cells over the CarpetX default domain [-1, 1]^3 (dx = 0.25): the fixture
# cells of MCNuX_SyntheticDeposit are defined against exactly this grid, each
# lying on one of CarpetX's TSV output lines (transverse coordinate 0 -> cell
# index 4).
CarpetX::ncells_x = 8
CarpetX::ncells_y = 8
CarpetX::ncells_z = 8

# Two transport steps (the cross-step accumulation-leak observable needs at
# least two deposits with an intervening zero point).
Cactus::cctk_itlast = 2

IO::out_dir = $parfile
IO::out_every = 1
IO::parfile_write = no

# Keep the column-label header but drop IOUtil's creation date, hostname, and
# absolute parameter-file path (see unit-selftest.par).
IO::out_fileinfo = "axis labels"

CarpetX::out_metadata = no

# The golden data: the deposited source-term variables, one x/y/z line triple
# per iteration.
CarpetX::out_tsv_vars = "
    MCNuX::rad_force
    MCNuX::lepton_source
"
