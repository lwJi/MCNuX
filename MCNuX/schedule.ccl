# Schedule definitions for thorn MCNuX

# Paramcheck guard of specs/carpetx-thorn-integration.md [MCNX-CTX-06]. The
# routine is scheduled unconditionally and branches on the parameter inside
# its body, so that the abort is reached in exactly the configuration the
# spec forbids. Global mode: the routine touches no grid data (hence no
# READS:/WRITES: clauses) and must run exactly once.

SCHEDULE MCNuX_ParamCheck AT CCTK_PARAMCHECK
{
  LANG: C
  OPTIONS: global
} "Abort when CarpetX subcycling is enabled (MCNuX transport is single-rate)"

# Unit self-test battery of specs/verification-suite-design.md [MCNX-VER-06]
# (the `unit-selftest` benchmark). Storage and scheduling are both guarded by
# the parameter, so a production run carries neither the array nor the
# routine; when the parameter is off the group has no storage and the TSV
# writer skips it. Global mode: the battery is a rank-independent computation
# over MCNuX's own compile-time code and must run exactly once. The WRITES:
# clause is complete per [MCNX-CTX-04] — the routine touches no other grid
# variable.

if (run_selftests)
{
  STORAGE: mcnux_selftest

  SCHEDULE MCNuX_SelfTest AT initial
  {
    LANG: C
    OPTIONS: global
    WRITES: MCNuX::mcnux_selftest(everywhere)
  } "Run the MCNuX unit self-test battery"
}

STORAGE: mcnux_transport_diag

# Source-term grid variables of specs/hydro-coupling-source-terms.md
# [MCNX-HYD-01]: always-on storage (single timelevel) — they are the published
# coupling interface, not test scaffolding, so storage is NOT parameter-gated.

STORAGE: rad_force lepton_source

# Transport-cadence contract of specs/carpetx-thorn-integration.md
# [MCNX-CTX-05]: transport is operator-split from the fluid/spacetime
# evolution and advances exactly once per coarsest-level Delta t, outside the
# RK substeps, after the fluid step (including its ODESolvers_PostStep pass)
# has completed. The canonical realization is the MCNuX-owned schedule group
# below, AT evol AFTER ODESolvers_Solve. `IN ODESolvers_PostStep` (once per RK
# stage) and `AT CCTK_POSTSTEP` (fragile interleaving with regridding and
# analysis) were considered and rejected by the spec.
#
# Under the single-rate pin CarpetX::use_subcycling = no ([MCNX-CTX-06],
# enforced by MCNuX_ParamCheck above) every level shares the coarsest-level
# Delta t, so one CCTK_EVOL traversal is one transport step.

SCHEDULE GROUP MCNuX_TransportStep AT evol AFTER ODESolvers_Solve
{
} "MCNuX transport step (operator-split, once per coarsest-level dt)"

# Initialize the cadence counter before the first evolution step, so that the
# observer's declared READS: below sees valid data on iteration 1. Global
# mode: the routine touches only grid scalars and must run exactly once.

SCHEDULE MCNuX_TransportInit AT initial
{
  LANG: C
  OPTIONS: global
  WRITES: MCNuX::transport_step_count(everywhere)
} "Initialize the MCNuX transport-step counter"

# The cadence observable: one increment and one log line per transport step.
# Global mode per [MCNX-CTX-03] (the routine walks no tiles itself, and global
# mode is what makes "exactly once per CCTK_EVOL traversal" observable rather
# than once per (patch, level, component)). The READS:/WRITES: clauses are
# complete per [MCNX-CTX-04]: the counter is the only grid variable touched —
# the driver objects reached through ghext ([MCNX-CTX-01]) are inspected for
# structure only, no grid data is read or written through them.

SCHEDULE MCNuX_TransportObserver IN MCNuX_TransportStep
{
  LANG: C
  OPTIONS: global
  READS: MCNuX::transport_step_count(everywhere)
  WRITES: MCNuX::transport_step_count(everywhere)
} "Advance and report the MCNuX transport-step counter (cadence observable)"

# Zero-then-add protocol of specs/hydro-coupling-source-terms.md
# [MCNX-HYD-03], modeled on CarpetX/TmunuBaseX/schedule.ccl: the source-term
# variables are zeroed at one schedule point, accumulated into by
# contributors, and only then read. The zero point lives at the START of the
# transport group, so the tallied values persist across the step boundary for
# the fluid's RHS reads at step n+1 (the one-step lag of [MCNX-CTX-05]).
#
# The same routine is also scheduled AT initial: it provides the variables'
# initial data (all-zero — no transport has happened), so that iteration-0
# output and a checkpoint written before the first transport step see defined
# values ([MCNX-HYD-01] lifetime).

SCHEDULE MCNuX_ZeroSourceTerms AT initial
{
  LANG: C
  WRITES: MCNuX::rad_force(everywhere)
  WRITES: MCNuX::lepton_source(everywhere)
} "Initialize the MCNuX source-term variables to zero"

SCHEDULE MCNuX_ZeroSourceTerms IN MCNuX_TransportStep
{
  LANG: C
  WRITES: MCNuX::rad_force(everywhere)
  WRITES: MCNuX::lepton_source(everywhere)
} "Set the MCNuX source-term variables to zero"

# Geodesic push of specs/geodesic-propagation.md over the synthetic packet
# fixture (verification scaffolding, parameter-gated; the production packet
# population arrives with the emission task). The seed routine runs once AT
# initial, after ODESolvers_Initial has produced the ADMBaseX initial data it
# reads for the p_t column of the diagnostic table; the push runs inside the
# transport group between the zero point and the contributors, once per
# coarsest-level Delta t ([MCNX-CTX-05]). Level mode per [MCNX-CTX-03]: the
# driver invokes the routine exactly once per traversal and it walks all
# patches, levels, and particle tiles itself (global mode for the seed, which
# also touches no per-level data beyond the metric reads). The READS: on the
# ADMBaseX groups and the READS:/WRITES: on the diagnostic table are the
# complete grid-variable footprint ([MCNX-CTX-04]); the packet container
# itself is not a grid variable.

if (test_synthetic_packets)
{
  STORAGE: mcnux_packet_diag

  SCHEDULE MCNuX_SeedSyntheticPackets AT initial AFTER ODESolvers_Initial
  {
    LANG: C
    OPTIONS: global
    READS: ADMBaseX::metric(everywhere)
    READS: ADMBaseX::lapse(everywhere)
    READS: ADMBaseX::shift(everywhere)
    WRITES: MCNuX::mcnux_packet_diag(everywhere)
  } "Seed the deterministic synthetic packet fixture"

  SCHEDULE MCNuX_GeodesicPush IN MCNuX_TransportStep AFTER MCNuX_ZeroSourceTerms BEFORE MCNuX_AddToSourceTerms
  {
    LANG: C
    OPTIONS: level
    READS: ADMBaseX::metric(everywhere)
    READS: ADMBaseX::lapse(everywhere)
    READS: ADMBaseX::shift(everywhere)
    READS: MCNuX::mcnux_packet_diag(everywhere)
    WRITES: MCNuX::mcnux_packet_diag(everywhere)
  } "Push every packet along its null geodesic over one transport step"
}

# Fluid-state/four-velocity gather diagnostic of
# specs/neutrino-matter-interactions.md ([MCNX-INT-05]: cell-centered fluid
# state of the packet's containing cell, direct one-cell read; inputs table:
# cell-centered u^mu with g_munu u^mu u^nu = -1). Parameter-gated
# verification scaffolding (the `hydro-sphere-gather` benchmark). The initial
# leg provides the table's iteration-0 data (after ODESolvers_Initial has
# produced both the ADMBaseX and HydroBaseX initial data, and after the
# packet seeding when that fixture is active); the in-step leg refreshes the
# table after the push, once per coarsest-level Delta t. Modes mirror the
# seed/push pair above ([MCNX-CTX-03]); the READS: on the ADMBaseX and
# HydroBaseX groups plus the table WRITES: are the complete grid-variable
# footprint ([MCNX-CTX-04]).

if (test_fluid_gather)
{
  STORAGE: mcnux_fluid_diag

  SCHEDULE MCNuX_FluidGatherDiag AT initial AFTER ODESolvers_Initial AFTER MCNuX_SeedSyntheticPackets
  {
    LANG: C
    OPTIONS: global
    READS: ADMBaseX::metric(everywhere)
    READS: ADMBaseX::lapse(everywhere)
    READS: ADMBaseX::shift(everywhere)
    READS: HydroBaseX::rho(everywhere)
    READS: HydroBaseX::vel(everywhere)
    READS: HydroBaseX::temperature(everywhere)
    READS: HydroBaseX::Ye(everywhere)
    WRITES: MCNuX::mcnux_fluid_diag(everywhere)
  } "Fill the per-packet fluid-gather diagnostic table (initial data)"

  SCHEDULE MCNuX_FluidGatherDiag IN MCNuX_TransportStep AFTER MCNuX_GeodesicPush
  {
    LANG: C
    OPTIONS: level
    READS: ADMBaseX::metric(everywhere)
    READS: ADMBaseX::lapse(everywhere)
    READS: ADMBaseX::shift(everywhere)
    READS: HydroBaseX::rho(everywhere)
    READS: HydroBaseX::vel(everywhere)
    READS: HydroBaseX::temperature(everywhere)
    READS: HydroBaseX::Ye(everywhere)
    READS: MCNuX::mcnux_fluid_diag(everywhere)
    WRITES: MCNuX::mcnux_fluid_diag(everywhere)
  } "Refresh the per-packet fluid-gather diagnostic table after the push"
}

# The named, empty-by-default extension group (the TmunuBaseX_AddToTmunu
# analogue): every deposition routine is a contributor scheduled in here — a
# self-accumulating READS: + WRITES: pair on the source variables, performing
# read-modify-write += only, ordered after the zeroing by group ordering.

SCHEDULE GROUP MCNuX_AddToSourceTerms IN MCNuX_TransportStep AFTER MCNuX_ZeroSourceTerms
{
} "Add to the MCNuX source-term variables here"

# The synthetic-event contributor (verification scaffolding, parameter-gated):
# proves the deposition/ledger path of [MCNX-HYD-02] before any real event
# producer exists. The complete self-accumulating READS:/WRITES: pair is the
# contributor idiom of [MCNX-HYD-03], enforced at runtime by the driver's
# presync/poison machinery ([MCNX-CTX-04]).

if (test_synthetic_deposit)
{
  SCHEDULE MCNuX_SyntheticDeposit IN MCNuX_AddToSourceTerms
  {
    LANG: C
    READS: MCNuX::rad_force(everywhere)
    READS: MCNuX::lepton_source(everywhere)
    WRITES: MCNuX::rad_force(everywhere)
    WRITES: MCNuX::lepton_source(everywhere)
  } "Deposit a synthetic, iteration-scaled event list (ledger-path observable)"
}

# Conservation-ledger closure diagnostic of [MCNX-HYD-05]
# (hydro-coupling-source-terms.md:177-188; verification scaffolding,
# parameter-gated): after all contributors have run, audit the per-channel
# balance between the grid total Sum_cells (source)*dV*dt (reduced from the
# deposited variables through the driver's MultiFabs, valid cells only) and
# the event-side packet total rebuilt independently from the shared synthetic
# LedgerDelta list. Global mode: one verdict per transport step, the routine
# walks the patches/levels itself ([MCNX-CTX-03]); the READS: on the source
# groups and the WRITES: on the verdict table are the complete grid-variable
# footprint ([MCNX-CTX-04]). The AT initial leg audits the all-zero state
# (zeroed variables, scale-0 event list — the documented eps0-floor branch)
# and gives the table defined iteration-0 output, mirroring the
# packet-diag/fluid-diag precedent.

if (test_ledger_closure)
{
  STORAGE: mcnux_ledger_diag

  SCHEDULE MCNuX_LedgerClosure AT initial AFTER MCNuX_ZeroSourceTerms
  {
    LANG: C
    OPTIONS: global
    READS: MCNuX::rad_force(everywhere)
    READS: MCNuX::lepton_source(everywhere)
    WRITES: MCNuX::mcnux_ledger_diag(everywhere)
  } "Audit the conservation-ledger closure of the all-zero initial state"

  SCHEDULE MCNuX_LedgerClosure IN MCNuX_TransportStep AFTER MCNuX_AddToSourceTerms
  {
    LANG: C
    OPTIONS: global
    READS: MCNuX::rad_force(everywhere)
    READS: MCNuX::lepton_source(everywhere)
    WRITES: MCNuX::mcnux_ledger_diag(everywhere)
  } "Audit the per-step five-channel conservation-ledger closure"
}
