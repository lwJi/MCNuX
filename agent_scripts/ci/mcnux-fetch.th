# mcnux-fetch.th — GetComponents FETCH list for CI only.
#
# This is NOT the pinned test ThornList: agent_scripts/sandbox/mcnux.th
# (specs/build-and-integration.md [MCNX-BLD-04]) remains the binding COMPILE
# list. This file only fetches the pieces of the Cactus checkout that do not
# live in a repo CI checks out directly: the flesh, CactusBase/IOUtil, and the
# five ExternalLibraries providers. The CarpetX, WeakLibInterp, and MCNuX
# arrangements are supplied as symlinks to pinned checkouts by
# agent_scripts/ci/download.sh (the same wiring as agent_scripts/sandbox/setup.sh).
#
# Blocks are modeled on CarpetX/scripts/carpetx.th (the CarpetX CI precedent).

!CRL_VERSION = 1.0

!DEFINE ROOT = Cactus
!DEFINE ARR  = $ROOT/arrangements
!DEFINE COMPONENTLIST_TARGET = $ROOT/thornlists/

# Cactus Flesh
!TARGET   = $ROOT
!TYPE     = git
!URL      = https://bitbucket.org/cactuscode/cactus.git
!NAME     = flesh
!CHECKOUT = .clang-format CONTRIBUTORS COPYRIGHT doc lib Makefile README.md src

# CactusBase thorns
!TARGET   = $ARR
!TYPE     = git
!URL      = https://bitbucket.org/cactuscode/cactusbase.git
!REPO_PATH = $2
!CHECKOUT =
CactusBase/IOUtil

# ExternalLibraries thorns (EinsteinToolkit organization)
!TARGET   = $ARR
!TYPE     = git
!URL      = https://github.com/EinsteinToolkit/$1-$2
!REPO_PATH = ../$1-$2
!CHECKOUT =
ExternalLibraries/HDF5
ExternalLibraries/MPI
ExternalLibraries/zlib

# ExternalLibraries thorns required for CarpetX (rhaas80 mirrors, as in carpetx.th)
!TARGET   = $ARR
!TYPE     = git
!URL      = https://github.com/rhaas80/$1-$2
!REPO_PATH = ../$1-$2
!CHECKOUT =
ExternalLibraries/AMReX
ExternalLibraries/yaml_cpp
