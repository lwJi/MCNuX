# Non-harness gate parfile: CarpetX subcycling ENABLED.
#
# Paramcheck guard of specs/carpetx-thorn-integration.md [MCNX-CTX-06]. This
# run is *expected to abort* at CCTK_PARAMCHECK with MCNuX's error, so it
# deliberately does not live under MCNuX/test/ (the Cactus regression harness
# would score a deliberate abort as a failure). It is driven by
# agent_scripts/gate_paramcheck.sh.
#
# This file and subcycling_no.par must stay identical except for the single
# CarpetX::use_subcycling line at the bottom.

ActiveThorns = "CarpetX MCNuX"

Cactus::cctk_itlast = 0

# CarpetX's own CCTK_PARAMCHECK routine rejects any other presync mode, and
# rejects restriction-during-sync whenever subcycling is on; both are set so
# that the driver's checks pass and the run reaches MCNuX's guard.
Cactus::presync_mode = "mixed-error"
CarpetX::restrict_during_sync = no

# Smallest useful grid: the guard fires before evolution, and the "no" twin
# must stay cheap.
CarpetX::ncells_x = 8
CarpetX::ncells_y = 8
CarpetX::ncells_z = 8

CarpetX::use_subcycling = yes
